{% extends 'base.html.twig' %}

{% block title %}StopClope - Accueil{% endblock %}

{% block body %}
<div class="container">
    <header class="header">
        <h1>StopClope</h1>
        <div id="offlineIndicator" style="display: none; background: var(--warning); color: #000; padding: 5px 12px; border-radius: 12px; font-size: 0.75rem; margin-top: 5px;">
            Mode hors-ligne
        </div>
    </header>

    <!-- Réveil du jour (compact) -->
    <div class="card" style="padding: 10px 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--text-secondary); font-size: 0.8rem;">Réveil</span>
                <span style="font-size: 1.1rem; font-weight: 600;" id="wakeupDisplay">{% if today_wakeup %}{{ today_wakeup.wakeTime|date('H:i') }}{% else %}--:--{% endif %}</span>
            </div>
            <button class="secondary-button" id="openWakeUpBtn" style="width: auto; margin: 0; padding: 6px 12px; font-size: 0.85rem;{% if not today_wakeup %} background: var(--accent);{% endif %}">
                {% if today_wakeup %}Modifier{% else %}Noter{% endif %}
            </button>
        </div>
    </div>

    <!-- Célébration nouveau palier -->
    {% if tier_achievement.achieved %}
    <div class="card tier-celebration" style="padding: 20px; text-align: center; background: linear-gradient(135deg, #ffd700, #ffec8b); border: 2px solid #ffd700;">
        <div style="font-size: 3rem; margin-bottom: 10px;" aria-hidden="true">🎉</div>
        <div style="color: #000; font-weight: 700; font-size: 1.2rem;">
            Nouveau palier atteint !
        </div>
        <div style="color: #333; font-size: 1rem; margin-top: 8px;">
            {{ tier_achievement.message }}
        </div>
        {% if tier_achievement.new_tier == 0 %}
        <div style="margin-top: 10px; font-size: 2rem;" aria-hidden="true">🏆</div>
        {% endif %}
    </div>
    {% endif %}

    <!-- Célébration première journée réussie -->
    {% if first_day_success.achieved %}
    <div class="card first-day-celebration" style="padding: 20px; text-align: center; background: linear-gradient(135deg, #00d4aa, #00ff88); border: 2px solid #00d4aa;">
        <div style="font-size: 3rem; margin-bottom: 10px;" aria-hidden="true">🌟</div>
        <div style="color: #000; font-weight: 700; font-size: 1.2rem;">
            Première journée réussie !
        </div>
        <div style="color: #333; font-size: 1rem; margin-top: 8px;">
            {{ first_day_success.message }}
        </div>
        <div style="margin-top: 10px; font-size: 1.5rem;" aria-hidden="true">💪🎯</div>
    </div>
    {% endif %}

    <!-- Message d'encouragement (compact) -->
    {% if encouragement %}
    <div class="card" style="padding: 10px 15px; background: {{ encouragement.type == 'success' ? 'linear-gradient(135deg, var(--success), #00ff88)' : 'linear-gradient(135deg, var(--warning), #ffdb4d)' }};">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 1.3rem;" aria-hidden="true">{{ encouragement.icon }}</span>
            <span style="color: #000; font-weight: 600; font-size: 0.9rem;">{{ encouragement.message }}</span>
        </div>
    </div>
    {% endif %}

    <!-- Objectif quotidien (compact) -->
    {% if goal_progress %}
    <div class="card" style="padding: 10px 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <span style="font-size: 0.8rem; color: var(--text-secondary);"><span aria-hidden="true">🎯</span> Objectif</span>
            <span style="font-weight: 700; font-size: 0.9rem; color: {{ goal_progress.exceeded ? 'var(--error)' : (goal_progress.remaining == 0 ? 'var(--warning)' : 'var(--success)') }};">
                {{ goal_progress.current }} / {{ goal_progress.goal }}
                {% if goal_progress.exceeded %}
                    (+{{ goal_progress.exceeded_by }})
                {% elseif goal_progress.remaining > 0 %}
                    <span style="font-weight: 400; color: var(--text-secondary);">({{ goal_progress.remaining }} restantes)</span>
                {% endif %}
            </span>
        </div>
        <div class="progress-bar" style="height: 6px; margin: 0;">
            <div class="progress-fill" style="width: {{ goal_progress.progress_percent }}%; background: {{ goal_progress.exceeded ? 'linear-gradient(90deg, var(--error), #ff6b6b)' : (goal_progress.progress_percent >= 80 ? 'linear-gradient(90deg, var(--warning), #ffdb4d)' : 'linear-gradient(90deg, var(--success), #00ff88)') }};"></div>
        </div>
    </div>
    {% endif %}

    <!-- Score du jour + Streak + Rank (compact) -->
    <div class="card" style="padding: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <!-- Score -->
            <div style="text-align: center;">
                <div class="score-value {{ daily_score.total_score < 0 ? 'negative' : '' }}" style="font-size: 2rem; margin: 0;">
                    {{ daily_score.total_score > 0 ? '+' : '' }}{{ daily_score.total_score }}
                </div>
                <div style="font-size: 0.7rem; color: var(--text-secondary);">pts</div>
            </div>
            <!-- Streak -->
            {% if streak.current > 0 %}
            <div style="text-align: center;">
                <div style="font-size: 1.3rem; font-weight: 700; color: {{ streak.today_positive ? 'var(--success)' : 'var(--warning)' }};">
                    <span aria-hidden="true">🔥</span> {{ streak.current }}
                </div>
                <div style="font-size: 0.7rem; color: var(--text-secondary);">série</div>
            </div>
            {% endif %}
            <!-- Rank -->
            <div style="text-align: center;">
                <div class="rank-badge" style="margin: 0; padding: 4px 10px; font-size: 0.75rem;">{{ rank.rank }}</div>
                <div style="font-size: 0.65rem; color: var(--text-secondary); margin-top: 4px;">{{ rank.total_score }}/{{ rank.next_rank_threshold }}</div>
            </div>
        </div>
        <div class="progress-bar" style="height: 4px; margin-top: 10px;">
            <div class="progress-fill" style="width: {{ rank.progress }}%"></div>
        </div>
    </div>

    <!-- Compte à rebours (compact) -->
    {% if next_cig_target %}
    <div class="card" style="padding: 10px 15px;">
        {% if next_cig_target.status == 'active' or next_cig_target.status == 'exceeded' %}
            <div id="points-display"
                 data-wake-minutes="{{ next_cig_target.wake_minutes }}"
                 data-target-minutes="{{ next_cig_target.target_minutes }}"
                 data-avg-interval="{{ next_cig_target.avg_interval }}"
                 style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <div id="current-points-msg" style="font-size: 0.95rem;">Chargement...</div>
                <div id="next-tier-info" style="display: none; text-align: right;">
                    <div id="countdown" style="font-size: 1.1rem; font-weight: 700; color: var(--warning);"></div>
                    <div id="next-tier-msg" style="color: var(--text-secondary); font-size: 0.7rem;"></div>
                </div>
            </div>
        {% elseif next_cig_target.status == 'no_wakeup' %}
            <div style="color: var(--warning); font-size: 0.85rem;">
                <span aria-hidden="true">⏰</span> {{ next_cig_target.message }}
            </div>
        {% elseif next_cig_target.status == 'first_day' %}
            <div style="color: var(--text-secondary); font-size: 0.85rem;">
                <span aria-hidden="true">📊</span> {{ next_cig_target.message }}
            </div>
        {% endif %}
    </div>
    {% endif %}

    <!-- Stats du jour (compact) -->
    <div class="card stats-compact">
        <div class="stats-row">
            <div class="stat-main">
                <span class="stat-value" id="todayCount">{{ today_cigarettes|length }}</span>
                <span class="stat-label">clopes</span>
            </div>
            <div class="stat-comparison">
                {% set diff = yesterday_count - today_cigarettes|length %}
                <span class="stat-diff {{ diff > 0 ? 'positive' : (diff < 0 ? 'negative' : '') }}">
                    {{ diff >= 0 ? '+' : '' }}{{ diff }} vs hier
                </span>
            </div>
        </div>
    </div>

    <!-- Détail des points (accordéon) -->
    <div class="card">
        <details class="accordion">
            <summary class="accordion-header">
                <h3 style="margin: 0; display: inline;">Détail des points</h3>
                <span class="accordion-icon" aria-hidden="true">▼</span>
            </summary>
        <div class="score-breakdown" style="margin-top: 10px;">
            {% if daily_score.details.comparisons is defined %}
                {% for comp in daily_score.details.comparisons %}
                <div class="breakdown-item">
                    <span>
                        {% if comp.exceeded is defined and comp.exceeded %}⚠️ {% endif %}
                        Clope #{{ comp.index }} ({{ comp.diff > 0 ? '+' : '' }}{{ comp.diff }} min)
                    </span>
                    <span class="breakdown-score {{ comp.points > 0 ? 'positive' : 'negative' }}">
                        {{ comp.points > 0 ? '+' : '' }}{{ comp.points }}
                    </span>
                </div>
                {% endfor %}

                {# Séparateur avant les bonus potentiels #}
                {% set has_potential_bonus = (daily_score.potential_reduction_bonus is defined and daily_score.potential_reduction_bonus > 0)
                    or (daily_score.potential_regularity_bonus is defined and daily_score.potential_regularity_bonus > 0)
                    or (daily_score.potential_weekly_bonus is defined and daily_score.potential_weekly_bonus > 0) %}

                {% if has_potential_bonus %}
                <div style="border-top: 1px dashed var(--bg-secondary); margin-top: 8px; padding-top: 8px;">
                    <div style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 6px; font-style: italic;">
                        ⏳ Bonus potentiels (acquis en fin de journée)
                    </div>
                </div>
                {% endif %}

                {# Bonus de réduction vs hier (potentiel) #}
                {% if daily_score.potential_reduction_bonus is defined and daily_score.potential_reduction_bonus > 0 %}
                <div class="breakdown-item" style="opacity: 0.7;">
                    <span><span aria-hidden="true">📉</span> Réduction vs hier (-{{ daily_score.yesterday_count - daily_score.cigarette_count }})</span>
                    <span class="breakdown-score" style="color: var(--text-secondary);">+{{ daily_score.potential_reduction_bonus }}</span>
                </div>
                {% endif %}

                {# Bonus tendance hebdo (potentiel) #}
                {% if daily_score.potential_weekly_bonus is defined and daily_score.potential_weekly_bonus > 0 %}
                <div class="breakdown-item" style="opacity: 0.7;">
                    <span><span aria-hidden="true">📊</span> Tendance hebdo positive</span>
                    <span class="breakdown-score" style="color: var(--text-secondary);">+{{ daily_score.potential_weekly_bonus }}</span>
                </div>
                {% endif %}

                {# Bonus de régularité (potentiel) #}
                {% if daily_score.potential_regularity_bonus is defined and daily_score.potential_regularity_bonus > 0 %}
                <div class="breakdown-item" style="opacity: 0.7;">
                    <span><span aria-hidden="true">⭐</span> Bonus régularité</span>
                    <span class="breakdown-score" style="color: var(--text-secondary);">+{{ daily_score.potential_regularity_bonus }}</span>
                </div>
                {% endif %}
            {% elseif daily_score.details.message is defined %}
                <div class="breakdown-item">
                    <span>{{ daily_score.details.message }}</span>
                </div>
            {% endif %}
        </div>
        </details>
    </div>

    <!-- Guide premier jour -->
    {% if next_cig_target.status == 'first_day' and today_cigarettes|length == 0 %}
    <div class="card" style="padding: 20px; background: linear-gradient(135deg, var(--bg-card), var(--bg-secondary)); border: 2px dashed var(--accent);">
        <div style="text-align: center;">
            <div style="font-size: 2.5rem; margin-bottom: 10px;" aria-hidden="true">👋</div>
            <h3 style="margin-bottom: 10px; color: var(--text-primary);">Bienvenue !</h3>
            <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5;">
                C'est ton premier jour. Enregistre chaque cigarette pour commencer à créer ton historique.
            </p>
            <div style="margin-top: 15px; padding: 12px; background: var(--bg-secondary); border-radius: 8px;">
                <div style="font-size: 0.85rem; color: var(--text-secondary);">
                    <strong style="color: var(--accent);"><span aria-hidden="true">💡</span> Conseil :</strong> Les points seront calculés à partir de demain, une fois ton historique créé.
                </div>
            </div>
        </div>
    </div>
    {% elseif next_cig_target.status == 'first_day' and today_cigarettes|length > 0 and today_cigarettes|length < 3 %}
    <div class="card" style="padding: 15px; background: var(--bg-card);">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="font-size: 1.8rem;" aria-hidden="true">📊</div>
            <div>
                <div style="font-weight: 600; color: var(--text-primary);">Continue comme ça !</div>
                <div style="font-size: 0.85rem; color: var(--text-secondary);">
                    {{ today_cigarettes|length }} clope{{ today_cigarettes|length > 1 ? 's' : '' }} enregistrée{{ today_cigarettes|length > 1 ? 's' : '' }}. Demain, tu verras tes premiers points.
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Liste des clopes du jour -->
    <div class="card">
        <h3 style="margin-bottom: 10px;">Clopes du jour</h3>
        {% if today_cigarettes|length > 0 %}
            <ul class="cig-list" id="cigList">
                {% for cig in today_cigarettes %}
                    <li class="cig-item" data-id="{{ cig.id }}">
                        <div>
                            <span class="cig-time">{{ cig.smokedAt|date('H:i') }}</span>
                            {% if cig.isRetroactive %}
                                <span class="cig-badge">ajoutée après</span>
                            {% endif %}
                        </div>
                        <button class="delete-btn" data-cig-id="{{ cig.id }}" aria-label="Supprimer la cigarette de {{ cig.smokedAt|date('H:i') }}"><span aria-hidden="true">✕</span></button>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="empty-state">
                <div class="empty-state-icon" aria-hidden="true">🎉</div>
                <p>Aucune clope aujourd'hui !</p>
            </div>
        {% endif %}
    </div>

    <!-- Spacer pour le bouton sticky -->
    <div class="sticky-spacer"></div>
</div>

<!-- Boutons d'action sticky -->
<div class="sticky-actions">
    <button class="big-button" id="logBtn">
        <span aria-hidden="true">🚬</span> J'ai fumé
    </button>
    <button class="secondary-button" id="openRetroModalBtn">
        <span aria-hidden="true">⏰</span> Ajouter une clope passée
    </button>
</div>

<!-- Modal ajout rétroactif -->
<div class="modal" id="retroModal" role="dialog" aria-modal="true" aria-labelledby="retroModalTitle">
    <div class="modal-content">
        <h2 class="modal-title" id="retroModalTitle">Ajouter une clope passée</h2>

        <!-- Boutons rapides -->
        <div class="quick-buttons" style="display: flex; gap: 8px; margin-bottom: 15px; flex-wrap: wrap;">
            <button type="button" class="btn-quick" data-quick-time="15">Il y a 15 min</button>
            <button type="button" class="btn-quick" data-quick-time="30">Il y a 30 min</button>
            <button type="button" class="btn-quick" data-quick-time="60">Il y a 1h</button>
        </div>

        <div class="input-group">
            <label for="customTime">Ou choisis une date/heure</label>
            <input type="datetime-local" id="customTime" aria-describedby="customTimeHelp">
            <small id="customTimeHelp" style="color: var(--text-secondary); font-size: 0.75rem;">Sélectionne la date et l'heure de la cigarette</small>
        </div>
        <div class="modal-buttons">
            <button class="btn-cancel" id="closeRetroModalBtn">Annuler</button>
            <button class="btn-confirm" id="logRetroactiveBtn">Ajouter</button>
        </div>
    </div>
</div>

<!-- Modal réveil -->
<div class="modal" id="wakeUpModal" role="dialog" aria-modal="true" aria-labelledby="wakeUpModalTitle">
    <div class="modal-content">
        <h2 class="modal-title" id="wakeUpModalTitle">Heure de réveil</h2>
        <p id="wakeUpModalSubtitle" style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 15px; display: none;">
            Note ton heure de réveil pour un calcul précis des points
        </p>
        <div class="input-group">
            <label for="wakeTime">Heure</label>
            <input type="time" id="wakeTime" aria-required="true">
        </div>
        <div class="modal-buttons">
            <button class="btn-cancel" id="wakeUpCancelBtn">Annuler</button>
            <button class="btn-cancel" id="wakeUpLaterBtn" style="display: none;">Plus tard</button>
            <button class="btn-confirm" id="saveWakeUpBtn">Enregistrer</button>
        </div>
    </div>
</div>

<!-- Modal confirmation suppression (accessible) -->
<div class="modal" id="confirmModal" role="alertdialog" aria-modal="true" aria-labelledby="confirmModalTitle" aria-describedby="confirmModalDesc">
    <div class="modal-content">
        <h2 class="modal-title" id="confirmModalTitle">Supprimer cette clope ?</h2>
        <p id="confirmModalDesc" style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 15px;">
            Cette action est irréversible.
        </p>
        <div class="modal-buttons">
            <button class="btn-cancel" id="confirmCancelBtn">Annuler</button>
            <button class="btn-confirm btn-danger" id="confirmOkBtn">Supprimer</button>
        </div>
    </div>
</div>

<script nonce="{{ csp_nonce() }}">
(function() {
    // Get CSRF token for secure requests
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    // Set default datetime to now
    document.getElementById('customTime').value = new Date().toISOString().slice(0, 16);
    document.getElementById('wakeTime').value = new Date().toTimeString().slice(0, 5);

    // Ouvrir automatiquement le modal de réveil si pas encore renseigné aujourd'hui
    {% if show_wakeup_modal %}
    // Vérifier si l'utilisateur n'a pas déjà cliqué "Plus tard" aujourd'hui
    var dismissedDate = sessionStorage.getItem('wakeupDismissed');
    var todayStr = new Date().toISOString().slice(0, 10);
    if (dismissedDate !== todayStr) {
        document.getElementById('wakeUpModalTitle').textContent = 'Bonjour !';
        document.getElementById('wakeUpModalSubtitle').style.display = 'block';
        document.getElementById('wakeUpCancelBtn').style.display = 'none';
        document.getElementById('wakeUpLaterBtn').style.display = 'block';
        document.getElementById('wakeUpModal').classList.add('active');
    }
    {% endif %}

    // Calcul des points côté client (v2.0 - multiplicateurs de zone, SANS PLAFOND)
    var pointsDisplay = document.getElementById('points-display');
    if (pointsDisplay && pointsDisplay.dataset.wakeMinutes && pointsDisplay.dataset.targetMinutes) {
        var wakeMinutes = parseInt(pointsDisplay.dataset.wakeMinutes);
        var targetMinutes = parseFloat(pointsDisplay.dataset.targetMinutes);

        // Multiplicateurs de zone v2.0 (identiques à MultiplierCalculator.php)
        // Zone négative (fumé AVANT la cible):
        //   0-10 min: ×1.0, 10-20 min: ×1.5, 20+ min: ×2.0
        // Zone positive (fumé APRÈS la cible):
        //   0-30 min: ×1.0, 30-60 min: ×1.2, 60+ min: ×1.5
        function getZoneMultiplier(diff) {
            var absMinutes = Math.abs(diff);
            if (diff < 0) {
                // Zone négative
                if (absMinutes <= 10) return 1.0;
                if (absMinutes <= 20) return 1.5;
                return 2.0;
            } else {
                // Zone positive
                if (absMinutes <= 30) return 1.0;
                if (absMinutes <= 60) return 1.2;
                return 1.5;
            }
        }

        // Points = diff × zoneMultiplier (SANS PLAFOND)
        function getPointsForDiff(diff) {
            var zoneMultiplier = getZoneMultiplier(diff);
            return Math.round(diff * zoneMultiplier);
        }

        function updatePointsDisplay() {
            // Calcul basé sur l'heure locale UNIQUEMENT (pas de timestamp)
            var now = new Date();
            var nowMinutes = now.getHours() * 60 + now.getMinutes();
            var currentMinutesSinceWake = nowMinutes - wakeMinutes;
            var diff = currentMinutesSinceWake - targetMinutes;
            var currentPoints = getPointsForDiff(diff);

            var currentMsg = document.getElementById('current-points-msg');
            var nextInfo = document.getElementById('next-tier-info');
            var nextMsg = document.getElementById('next-tier-msg');
            var countdown = document.getElementById('countdown');

            // Afficher les points actuels
            if (currentPoints > 0) {
                currentMsg.innerHTML = '<span style="color: var(--success); font-size: 1.1rem; font-weight: 600;">Tu gagnerais +' + currentPoints + ' pts</span>';
            } else if (currentPoints === 0) {
                currentMsg.innerHTML = '<span style="color: var(--text-secondary); font-size: 1.1rem; font-weight: 600;">Tu gagnerais 0 pt</span>';
            } else {
                currentMsg.innerHTML = '<span style="color: var(--accent); font-size: 1.1rem; font-weight: 600;">Tu perdrais ' + Math.abs(currentPoints) + ' pts</span>';
            }

            // Affichage du prochain seuil de zone
            var minutesToNext;

            if (diff < 0) {
                // En négatif : afficher L'HEURE cible (diff = 0)
                minutesToNext = Math.ceil(-diff);

                var targetTime = new Date();
                targetTime.setMinutes(targetTime.getMinutes() + minutesToNext);
                var targetHour = targetTime.getHours().toString().padStart(2, '0');
                var targetMin = targetTime.getMinutes().toString().padStart(2, '0');

                if (minutesToNext > 0) {
                    countdown.textContent = targetHour + ':' + targetMin;
                    countdown.style.color = 'var(--warning)';
                    nextMsg.textContent = 'cible';
                    nextInfo.style.display = 'block';
                    // Notification persistante avec l'heure cible
                    if (Notification.permission === 'granted') {
                        scheduleTargetNotification(targetHour + ':' + targetMin, minutesToNext * 60000);
                    }
                } else {
                    countdown.textContent = '✓';
                    countdown.style.color = 'var(--success)';
                    nextMsg.textContent = 'OK';
                    nextInfo.style.display = 'block';
                    dismissTargetNotification();
                }
            } else {
                // Cible atteinte : fermer la notification
                dismissTargetNotification();
                // En positif : afficher le prochain seuil de zone bonus
                // Zones: 0-30 min ×1.0, 30-60 min ×1.2, 60+ min ×1.5
                var nextThreshold, nextMultiplier;
                if (diff < 30) {
                    nextThreshold = 30;
                    nextMultiplier = '×1.2';
                } else if (diff < 60) {
                    nextThreshold = 60;
                    nextMultiplier = '×1.5';
                } else {
                    // Déjà au max, pas de prochain seuil
                    nextInfo.style.display = 'none';
                    return;
                }

                minutesToNext = Math.ceil(nextThreshold - diff);
                if (minutesToNext > 0) {
                    countdown.textContent = minutesToNext + 'min';
                    countdown.style.color = 'var(--success)';
                    nextMsg.textContent = '→ ' + nextMultiplier;
                    nextInfo.style.display = 'block';
                } else {
                    nextInfo.style.display = 'none';
                }
            }
        }

        updatePointsDisplay();
        setInterval(updatePointsDisplay, 60000);

        // --- Notification système pour l'heure cible ---
        function scheduleTargetNotification(targetTimeStr, delayMs) {
            if (!('serviceWorker' in navigator) || !navigator.serviceWorker.controller) return;
            navigator.serviceWorker.controller.postMessage({
                type: 'SHOW_TARGET',
                targetTime: targetTimeStr,
                delayMs: delayMs
            });
        }
        function dismissTargetNotification() {
            if (!('serviceWorker' in navigator) || !navigator.serviceWorker.controller) return;
            navigator.serviceWorker.controller.postMessage({ type: 'DISMISS_TARGET' });
        }

        // Demander la permission notification (une seule fois)
        if ('Notification' in window && Notification.permission === 'default') {
            // Attendre une interaction utilisateur pour demander
            document.getElementById('logBtn').addEventListener('click', function requestNotifPerm() {
                Notification.requestPermission();
                document.getElementById('logBtn').removeEventListener('click', requestNotifPerm);
            }, { once: true });
        }
    }

    // Fonction pour faire une requête avec retry automatique (utile après réveil de l'app)
    function fetchWithRetry(url, options, retries) {
        retries = retries || 2;
        return fetch(url, options).then(function(response) {
            if (!response.ok) {
                var error = new Error('HTTP ' + response.status);
                error.status = response.status;
                throw error;
            }
            return response;
        }).catch(function(err) {
            // Si c'est une erreur réseau et qu'on a des retries restants
            if (retries > 0 && !err.status) {
                // Attendre un peu et réessayer (l'app peut être en train de se réveiller)
                return new Promise(function(resolve) {
                    setTimeout(resolve, 500);
                }).then(function() {
                    return fetchWithRetry(url, options, retries - 1);
                });
            }
            throw err;
        });
    }

    function logCigarette() {
        var btn = document.getElementById('logBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span> Enregistrement...';

        // Envoyer l'heure locale + offset timezone
        var now = new Date();
        var localTime = now.getFullYear() + '-' +
            String(now.getMonth() + 1).padStart(2, '0') + '-' +
            String(now.getDate()).padStart(2, '0') + ' ' +
            String(now.getHours()).padStart(2, '0') + ':' +
            String(now.getMinutes()).padStart(2, '0');
        var tzOffset = -now.getTimezoneOffset(); // En minutes, positif pour Est de UTC

        fetchWithRetry('{{ path('app_log_cigarette') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-Token': csrfToken
            },
            body: 'local_time=' + encodeURIComponent(localTime) + '&tz_offset=' + tzOffset
        })
        .then(function(response) {
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                // Feedback visuel enrichi avec points et streak
                var points = data.daily_score;
                var isPositive = points >= 0;
                var icon = isPositive ? '✅' : '⚠️';
                var type = isPositive ? 'success' : 'warning';
                var streak = data.streak;
                var cigaretteId = data.cigarette_id;

                // Message avec info streak si actif
                var message = 'Clope enregistrée';
                if (streak && streak.current > 0 && streak.today_positive) {
                    message += ' • 🔥 ' + streak.current + 'j';
                }

                // Variable pour savoir si on doit recharger
                var shouldReload = true;
                var reloadTimeout = null;

                // Fonction pour annuler la cigarette
                function undoCigarette() {
                    shouldReload = false;
                    if (reloadTimeout) clearTimeout(reloadTimeout);

                    fetch('/delete/' + cigaretteId, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-CSRF-Token': csrfToken
                        }
                    })
                    .then(function(response) { return response.json(); })
                    .then(function(result) {
                        if (result.success) {
                            showToast('Clope annulée', { type: 'info', icon: '↩️', duration: 2000 });
                            setTimeout(function() { window.location.reload(); }, 500);
                        } else {
                            showToast('Erreur lors de l\'annulation', { type: 'error', icon: '❌' });
                        }
                    })
                    .catch(function() {
                        showToast('Erreur réseau', { type: 'error', icon: '❌' });
                    });
                }

                // Toast avec bouton Annuler (8 secondes)
                showToast(message, {
                    type: type,
                    points: points,
                    icon: icon,
                    action: undoCigarette,
                    actionLabel: 'Annuler',
                    duration: 3000
                });

                // Afficher les nouveaux badges obtenus
                if (data.new_badges && data.new_badges.length > 0) {
                    data.new_badges.forEach(function(badge, index) {
                        setTimeout(function() {
                            showBadgeNotification(badge);
                        }, 1500 + (index * 2000));
                    });
                }

                // Afficher le message de bienvenue (premier log)
                if (data.welcome_message) {
                    var delay = (data.new_badges && data.new_badges.length > 0)
                        ? 1500 + (data.new_badges.length * 2000) + 500
                        : 1500;
                    setTimeout(function() {
                        showWelcomeMessage(data.welcome_message);
                    }, delay);
                }

                // Animation du bouton
                btn.classList.add('feedback-' + type);

                // Recharger la page après 3s si pas annulé
                reloadTimeout = setTimeout(function() {
                    if (shouldReload) {
                        window.location.reload();
                    }
                }, 3000);
            } else if (data.error) {
                showToast(data.error, { type: 'error', icon: '❌' });
            }
        })
        .catch(function(err) {
            // Vérifier si c'est vraiment un problème de réseau ou une erreur serveur
            if (err.status === 403) {
                // Token CSRF invalide - recharger la page pour en obtenir un nouveau
                showToast('Session expirée, rechargement...', { type: 'warning', icon: '🔄' });
                setTimeout(function() { window.location.reload(); }, 1000);
            } else if (err.status >= 500) {
                // Erreur serveur - ne pas mettre en queue offline
                showToast('Erreur serveur, réessayez', { type: 'error', icon: '❌' });
            } else {
                // Vraiment offline - ajouter à la queue
                addToOfflineQueue('log_cigarette', { local_time: localTime, tz_offset: tzOffset });
                showToast('Clope enregistrée (hors-ligne)', { icon: '📴' });
                // Incrémenter visuellement le compteur
                var countEl = document.getElementById('todayCount');
                countEl.textContent = parseInt(countEl.textContent) + 1;
            }
        })
        .finally(function() {
            // Garder le bouton désactivé 3s après un log réussi pour éviter les double-clics
            setTimeout(function() {
                btn.disabled = false;
                btn.innerHTML = '<span aria-hidden="true">🚬</span> J\'ai fumé une clope';
                btn.classList.remove('feedback-success', 'feedback-warning');
            }, 3000);
        });
    };

    // Afficher une notification de nouveau badge
    function showBadgeNotification(badge) {
        // Créer l'overlay
        var overlay = document.createElement('div');
        overlay.className = 'badge-notification-overlay';
        overlay.innerHTML = '<div class="badge-notification">' +
            '<div class="badge-notification-icon">' + badge.icon + '</div>' +
            '<div class="badge-notification-title">Nouveau badge !</div>' +
            '<div class="badge-notification-name">' + badge.name + '</div>' +
            '<div class="badge-notification-desc">' + badge.description + '</div>' +
            '<button class="big-button badge-dismiss-btn">Super !</button>' +
            '</div>';
        document.body.appendChild(overlay);

        // Event listener pour fermer
        overlay.querySelector('.badge-dismiss-btn').addEventListener('click', function() {
            overlay.remove();
        });

        // Animation d'entrée
        requestAnimationFrame(function() {
            overlay.classList.add('active');
        });

        // Auto-fermeture après 5 secondes
        setTimeout(function() {
            if (overlay.parentNode) {
                overlay.classList.remove('active');
                setTimeout(function() {
                    if (overlay.parentNode) overlay.remove();
                }, 300);
            }
        }, 5000);
    }

    // Afficher le message de bienvenue (premier log)
    function showWelcomeMessage(welcome) {
        var overlay = document.createElement('div');
        overlay.className = 'badge-notification-overlay welcome-overlay';
        overlay.innerHTML = '<div class="badge-notification welcome-notification">' +
            '<div class="badge-notification-icon">' + welcome.icon + '</div>' +
            '<div class="badge-notification-title">' + welcome.title + '</div>' +
            '<div class="badge-notification-desc">' + welcome.message + '</div>' +
            '<button class="big-button badge-dismiss-btn">C\'est parti !</button>' +
            '</div>';
        document.body.appendChild(overlay);

        // Event listener pour fermer
        overlay.querySelector('.badge-dismiss-btn').addEventListener('click', function() {
            overlay.remove();
        });

        requestAnimationFrame(function() {
            overlay.classList.add('active');
        });

        // Auto-fermeture après 8 secondes (plus long pour le premier message)
        setTimeout(function() {
            if (overlay.parentNode) {
                overlay.classList.remove('active');
                setTimeout(function() {
                    if (overlay.parentNode) overlay.remove();
                }, 300);
            }
        }, 8000);
    }

    // Formate une date en format datetime-local (YYYY-MM-DDTHH:MM) en heure LOCALE
    // IMPORTANT: Ne pas utiliser toISOString() car il convertit en UTC
    function formatLocalDateTime(date) {
        return date.getFullYear() + '-' +
            String(date.getMonth() + 1).padStart(2, '0') + '-' +
            String(date.getDate()).padStart(2, '0') + 'T' +
            String(date.getHours()).padStart(2, '0') + ':' +
            String(date.getMinutes()).padStart(2, '0');
    }

    function openModal() {
        document.getElementById('retroModal').classList.add('active');
        document.getElementById('customTime').value = formatLocalDateTime(new Date());
    }

    function closeModal() {
        document.getElementById('retroModal').classList.remove('active');
    }

    function setQuickTime(minutesAgo) {
        var date = new Date();
        date.setMinutes(date.getMinutes() - minutesAgo);
        document.getElementById('customTime').value = formatLocalDateTime(date);
        // Soumettre directement
        logRetroactive();
    }

    function logRetroactive() {
        var customTime = document.getElementById('customTime').value;
        // Convertir le format datetime-local (YYYY-MM-DDTHH:MM) en (YYYY-MM-DD HH:MM)
        var localTime = customTime.replace('T', ' ');
        var tzOffset = -new Date().getTimezoneOffset();

        fetchWithRetry('{{ path('app_log_cigarette') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-Token': csrfToken
            },
            body: 'local_time=' + encodeURIComponent(localTime) + '&tz_offset=' + tzOffset + '&is_retroactive=1'
        })
        .then(function(response) {
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                var points = data.daily_score;
                var isPositive = points >= 0;
                showToast('Clope ajoutée à ' + data.smoked_at, {
                    type: isPositive ? 'success' : 'warning',
                    points: points,
                    icon: '⏰'
                });
                closeModal();
                // Recharger la page pour afficher toutes les infos à jour
                setTimeout(function() {
                    window.location.reload();
                }, 800);
            } else if (data.error) {
                showToast(data.error, { type: 'error', icon: '❌' });
            }
        })
        .catch(function(err) {
            if (err.status === 403) {
                showToast('Session expirée, rechargement...', { type: 'warning', icon: '🔄' });
                setTimeout(function() { window.location.reload(); }, 1000);
            } else if (err.status >= 500) {
                showToast('Erreur serveur, réessayez', { type: 'error', icon: '❌' });
            } else {
                addToOfflineQueue('log_cigarette', { local_time: localTime, tz_offset: tzOffset });
                showToast('Clope ajoutée (hors-ligne)', { icon: '📴' });
                closeModal();
            }
        });
    }

    // Modal de confirmation accessible
    var pendingDeleteId = null;

    function deleteCigarette(id) {
        pendingDeleteId = id;
        document.getElementById('confirmModal').classList.add('active');
        // Focus sur le bouton de confirmation (action principale)
        setTimeout(function() {
            document.getElementById('confirmOkBtn').focus();
        }, 100);
    }

    function closeConfirmModal() {
        document.getElementById('confirmModal').classList.remove('active');
        pendingDeleteId = null;
    }

    function confirmDelete() {
        if (!pendingDeleteId) return;
        var id = pendingDeleteId;
        closeConfirmModal();

        fetch('/delete/' + id, {
            method: 'POST',
            headers: {
                'X-CSRF-Token': csrfToken
            }
        })
        .then(function(response) {
            if (!response.ok) throw new Error('Network error');
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                showToast('Clope supprimée', { type: 'success', icon: '🗑️' });
                // Recharger la page pour afficher toutes les infos à jour
                setTimeout(function() {
                    window.location.reload();
                }, 800);
            }
        })
        .catch(function(err) {
            showToast('Suppression impossible hors-ligne', { type: 'error', icon: '📴' });
        });
    }

    // Event listeners pour la modal de confirmation
    document.getElementById('confirmCancelBtn').addEventListener('click', closeConfirmModal);
    document.getElementById('confirmOkBtn').addEventListener('click', confirmDelete);
    document.getElementById('confirmModal').addEventListener('click', function(e) {
        if (e.target === this) closeConfirmModal();
    });
    // Gestion du clavier (Escape pour fermer)
    document.getElementById('confirmModal').addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeConfirmModal();
    });

    function openWakeUpModal() {
        document.getElementById('wakeUpModalTitle').textContent = 'Heure de réveil';
        document.getElementById('wakeUpModalSubtitle').style.display = 'none';
        document.getElementById('wakeUpCancelBtn').style.display = 'block';
        document.getElementById('wakeUpLaterBtn').style.display = 'none';
        document.getElementById('wakeUpModal').classList.add('active');
        document.getElementById('wakeTime').value = new Date().toTimeString().slice(0, 5);
    }

    function closeWakeUpModal() {
        document.getElementById('wakeUpModal').classList.remove('active');
    }

    function dismissWakeUpModal() {
        // Mémoriser que l'utilisateur a cliqué "Plus tard" pour cette session/journée
        sessionStorage.setItem('wakeupDismissed', new Date().toISOString().slice(0, 10));
        closeWakeUpModal();
        showToast('Tu pourras noter ton réveil plus tard', { icon: '⏰' });
    }

    function saveWakeUp() {
        var wakeTime = document.getElementById('wakeTime').value;
        var tzOffset = -new Date().getTimezoneOffset();

        fetchWithRetry('{{ path('app_log_wakeup') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-Token': csrfToken
            },
            body: 'wake_time=' + encodeURIComponent(wakeTime) + '&tz_offset=' + tzOffset
        })
        .then(function(response) {
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                showToast('Réveil enregistré à ' + data.wake_time, { type: 'success', icon: '⏰' });
                document.getElementById('wakeupDisplay').textContent = data.wake_time;
                closeWakeUpModal();
                // Mettre à jour le bouton sans reload
                var wakeBtn = document.querySelector('.card button.secondary-button');
                if (wakeBtn) {
                    wakeBtn.textContent = 'Modifier';
                    wakeBtn.style.background = '';
                }
            } else if (data.error) {
                showToast(data.error, { type: 'error', icon: '❌' });
            }
        })
        .catch(function(err) {
            if (err.status === 403) {
                showToast('Session expirée, rechargement...', { type: 'warning', icon: '🔄' });
                setTimeout(function() { window.location.reload(); }, 1000);
            } else if (err.status >= 500) {
                showToast('Erreur serveur, réessayez', { type: 'error', icon: '❌' });
            } else {
                addToOfflineQueue('log_wakeup', { wake_time: wakeTime, tz_offset: tzOffset });
                showToast('Réveil enregistré (hors-ligne)', { icon: '📴' });
                document.getElementById('wakeupDisplay').textContent = wakeTime;
                closeWakeUpModal();
            }
        });
    }

    // ===== Event Listeners =====

    // Bouton principal "J'ai fumé"
    document.getElementById('logBtn').addEventListener('click', logCigarette);

    // Bouton ouvrir modal rétroactif
    document.getElementById('openRetroModalBtn').addEventListener('click', openModal);

    // Modal rétroactif - fermer et soumettre
    document.getElementById('closeRetroModalBtn').addEventListener('click', closeModal);
    document.getElementById('logRetroactiveBtn').addEventListener('click', logRetroactive);

    // Boutons rapides (15min, 30min, 1h)
    document.querySelectorAll('[data-quick-time]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            setQuickTime(parseInt(this.dataset.quickTime, 10));
        });
    });

    // Boutons suppression de cigarette
    document.querySelectorAll('.delete-btn[data-cig-id]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            deleteCigarette(parseInt(this.dataset.cigId, 10));
        });
    });

    // Bouton ouvrir modal réveil
    document.getElementById('openWakeUpBtn').addEventListener('click', openWakeUpModal);

    // Modal réveil - boutons
    document.getElementById('wakeUpCancelBtn').addEventListener('click', closeWakeUpModal);
    document.getElementById('wakeUpLaterBtn').addEventListener('click', dismissWakeUpModal);
    document.getElementById('saveWakeUpBtn').addEventListener('click', saveWakeUp);

    // Close modals on outside click
    document.getElementById('retroModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });
    document.getElementById('wakeUpModal').addEventListener('click', function(e) {
        if (e.target === this) closeWakeUpModal();
    });

    // Gestion de l'indicateur offline
    var offlineIndicator = document.getElementById('offlineIndicator');
    function updateOnlineStatus() {
        if (!navigator.onLine) {
            offlineIndicator.style.display = 'inline-block';
        } else {
            offlineIndicator.style.display = 'none';
        }
    }
    updateOnlineStatus();
    window.addEventListener('online', updateOnlineStatus);
    window.addEventListener('offline', updateOnlineStatus);

    // Détecter quand l'app revient du background et rafraîchir si les données sont périmées
    var lastActiveTime = Date.now();
    var STALE_THRESHOLD = 5 * 60 * 1000; // 5 minutes

    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible') {
            var now = Date.now();
            var elapsed = now - lastActiveTime;

            // Si l'app était en background depuis plus de 5 min, rafraîchir
            if (elapsed > STALE_THRESHOLD) {
                console.log('App was in background for ' + Math.round(elapsed/1000) + 's, refreshing...');
                window.location.reload();
            }
        } else {
            lastActiveTime = Date.now();
        }
    });
})();
</script>
{% endblock %}
